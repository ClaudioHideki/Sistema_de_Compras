# Copie para .env na VPS. Não publique este arquivo com valores reais.
APP_ORIGIN=https://compras.seudominio.com.br
SETUP_TOKEN=SUBSTITUIR_POR_TOKEN_ALEATORIO_LONGO
# E-mail e número de exibição são cadastrados na tela Equipe e integrações.
# Configure o domínio remetente no provedor antes de ativar envios.
RESEND_API_KEY=
EMAIL_FROM=compras@construtorajrc.com.br
# WhatsApp: credenciais e ID oficial, não o número de telefone.
WA_TOKEN=
WA_PHONE_ID=
WA_API_VERSION=
# Modelo aprovado pt_BR, com cabeçalho Documento e sem parâmetros no corpo.
WA_TEMPLATE=
# Arquivei / Qive API (credenciais da API, diferentes do login pelo navegador).
QIVE_API_ID=
QIVE_API_KEY=
